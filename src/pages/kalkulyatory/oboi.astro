---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
import CalculatorIntro from '../../components/calculator/CalculatorIntro.astro';
import CalculatorResult from '../../components/calculator/CalculatorResult.astro';
import NumberField from '../../components/calculator/NumberField.astro';
import { calculators } from '../../data/calculators';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculatorCrumbs } from '../../lib/breadcrumbs';
import '../../styles/calculator.css';

const entry = calculators.find((item) => item.id === 'wallpaper');
if (!entry) throw new Error('В каталоге нет калькулятора обоев (id: wallpaper)');

const id = 'wp';
---

<BaseLayout title={entry.seo.title} description={entry.seo.description}>
  <div class="container calc-page">
    <Breadcrumbs items={calculatorCrumbs(entry)} />

    <CalculatorIntro
      entry={entry}
      lead="Сколько рулонов купить на прямоугольную комнату — с окнами, дверями и подгонкой рисунка."
    />

    <noscript>
      <p class="calc-noscript">
        Для расчёта нужен включённый JavaScript. Способ расчёта описан ниже — по нему можно
        посчитать вручную.
      </p>
    </noscript>

    <div class="calc-layout">
      <form class="calc-form" data-wallpaper-form novalidate aria-labelledby="calc-form-title">
        <h2 class="visually-hidden" id="calc-form-title">
          Параметры расчёта
        </h2>

        <fieldset class="calc-group">
          <legend class="calc-group__title">Размеры комнаты</legend>
          <div class="calc-group__fields">
            <NumberField name="roomLength" idPrefix={id} label="Длина комнаты" unit="м" />
            <NumberField name="roomWidth" idPrefix={id} label="Ширина комнаты" unit="м" />
            <NumberField
              name="wallHeight"
              idPrefix={id}
              label="Высота стен"
              unit="м"
              hint="Высота оклейки: от пола или плинтуса до потолка."
            />
          </div>
        </fieldset>

        <fieldset class="calc-group">
          <legend class="calc-group__title">
            Окна и двери <span class="calc-group__optional">необязательно</span>
          </legend>
          <p class="calc-group__hint">
            Все окна считаются одинаковыми, все двери — тоже. Если проёмов нет, оставьте поля
            пустыми.
          </p>
          <div class="calc-group__fields">
            <NumberField
              name="windowCount"
              idPrefix={id}
              label="Количество окон"
              unit="шт."
              inputmode="numeric"
              optional
            />
            <NumberField name="windowWidth" idPrefix={id} label="Ширина окна" unit="м" optional />
            <NumberField name="windowHeight" idPrefix={id} label="Высота окна" unit="м" optional />
            <NumberField
              name="doorCount"
              idPrefix={id}
              label="Количество дверей"
              unit="шт."
              inputmode="numeric"
              optional
            />
            <NumberField name="doorWidth" idPrefix={id} label="Ширина двери" unit="м" optional />
            <NumberField name="doorHeight" idPrefix={id} label="Высота двери" unit="м" optional />
          </div>
        </fieldset>

        <fieldset class="calc-group">
          <legend class="calc-group__title">Параметры рулона</legend>
          <p class="calc-group__hint">
            Размеры указаны на этикетке. Самые распространённые: 0,53 × 10,05 м и метровые 1,06 ×
            10,05 м.
          </p>
          <div class="calc-group__fields">
            <NumberField
              name="rollWidth"
              idPrefix={id}
              label="Ширина рулона"
              unit="м"
              value="0,53"
            />
            <NumberField
              name="rollLength"
              idPrefix={id}
              label="Длина рулона"
              unit="м"
              value="10,05"
            />
          </div>
        </fieldset>

        <fieldset class="calc-group">
          <legend class="calc-group__title">
            Рисунок и подрезка <span class="calc-group__optional">необязательно</span>
          </legend>
          <div class="calc-group__fields">
            <NumberField
              name="patternRepeat"
              idPrefix={id}
              label="Раппорт"
              unit="см"
              optional
              hint="Шаг повторения рисунка, указан на этикетке (например, 64). Без подгонки — оставьте пустым."
            />
            <NumberField
              name="trimAllowance"
              idPrefix={id}
              label="Запас на подрезку"
              unit="см"
              value="10"
              optional
              hint="На одну полосу, сверху и снизу вместе. Обычно 5–10 см."
            />
          </div>
        </fieldset>

        <fieldset class="calc-group">
          <legend class="calc-group__title">
            Цена <span class="calc-group__optional">необязательно</span>
          </legend>
          <div class="calc-group__fields">
            <NumberField
              name="rollPrice"
              idPrefix={id}
              label="Цена одного рулона"
              unit="₽"
              optional
              hint="Укажите, чтобы посчитать стоимость."
            />
          </div>
        </fieldset>

        <div class="calc-actions">
          <button class="button button--primary" type="submit">
            Рассчитать
          </button>
          <button class="button button--secondary" type="reset">
            Сбросить
          </button>
        </div>
      </form>

      <CalculatorResult
        headingId="calc-result-title"
        placeholder="Заполните размеры комнаты и рулона и нажмите «Рассчитать». После первого расчёта результат обновляется сразу при изменении параметров."
      >
        <p class="calc-result__main">
          <span class="calc-result__number" data-out="rolls"></span>
          <span class="calc-result__unit" data-out="rollsWord"></span>
        </p>
        <p class="calc-result__cost" data-row="totalCost" hidden>
          Стоимость: <strong data-out="totalCost"></strong>
        </p>

        <dl class="calc-result__list">
          <div>
            <dt>Периметр комнаты</dt>
            <dd>
              <span data-out="perimeter"></span> м
            </dd>
          </div>
          <div>
            <dt>Площадь стен</dt>
            <dd>
              <span data-out="wallArea"></span> м²
            </dd>
          </div>
          <div data-row="openings">
            <dt>Площадь окон и дверей</dt>
            <dd>
              <span data-out="openingsArea"></span> м²
            </dd>
          </div>
          <div>
            <dt>Полос по стенам</dt>
            <dd data-out="stripsForWalls"></dd>
          </div>
          <div data-row="openings">
            <dt>Из них не нужны на всю высоту</dt>
            <dd data-out="stripsSavedByOpenings"></dd>
          </div>
          <div>
            <dt>Полос на полную высоту</dt>
            <dd data-out="fullStrips"></dd>
          </div>
          <div>
            <dt>Длина одной полосы</dt>
            <dd>
              <span data-out="stripLength"></span> м
            </dd>
          </div>
          <div data-row="rollStart">
            <dt>Подгонка рисунка в начале рулона</dt>
            <dd>
              до <span data-out="rollStartAllowance"></span> м
            </dd>
          </div>
          <div>
            <dt>Полос из одного рулона</dt>
            <dd data-out="stripsPerRoll"></dd>
          </div>
          <div data-row="shortPieces">
            <dt>Коротких кусков над и под проёмами</dt>
            <dd>
              <span data-out="shortPieces"></span> шт., <span data-out="shortPiecesLength"></span> м
            </dd>
          </div>
          <div data-row="shortPieces">
            <dt>Дополнительно рулонов на куски</dt>
            <dd data-out="extraRollsForShortPieces"></dd>
          </div>
        </dl>

        <p class="calc-result__note" data-out="stripNote"></p>
        <p class="calc-result__note" data-row="openingsNote" data-out="openingsNote"></p>
        <p class="calc-result__note">
          Результат ориентировочный. Покупайте рулоны одной партии (номер партии — на этикетке):
          оттенок разных партий может отличаться.
        </p>
      </CalculatorResult>
    </div>

    <article class="calc-article">
      <p class="calc-article__intro">
        Посчитайте, сколько рулонов обоев купить для прямоугольной комнаты. Калькулятор раскладывает
        обои на вертикальные полосы, учитывает подгонку рисунка, запас на подрезку, окна и двери.
        Результат ориентировочный — он показывает, из чего складывается расход, чтобы его можно было
        проверить.
      </p>

      <section aria-labelledby="method-title">
        <h2 id="method-title">Как считается</h2>
        <p>
          Обои клеят вертикальными полосами, поэтому калькулятор считает не площадь, а полосы — и
          там, где точная раскладка неизвестна, выбирает вариант с запасом.
        </p>
        <ol>
          <li>
            Каждая стена делится на ширину рулона, неполная полоса округляется вверх: у угла её всё
            равно отрезают от целой. Полосы четырёх стен складываются. Обрезок угловой полосы на
            соседнюю стену не переносится — это даёт запас до одной полосы на стену.
          </li>
          <li>
            Длина полосы — это высота стен плюс запас на подрезку. Если у обоев есть раппорт, каждая
            полоса должна начинаться с той же точки рисунка, поэтому её длина округляется вверх до
            кратной раппорту.
          </li>
          <li>
            Из рулона выходит столько целых полос, сколько помещается в его длину. Если есть
            раппорт, в начале каждого рулона откладывается до одного раппорта, чтобы совместить
            рисунок с уже наклеенными полосами. Остаток короче полосы на стену не пойдёт.
          </li>
          <li>
            Окна и двери уменьшают расход только на те полосы, которые гарантированно целиком
            попадают в ширину проёма. Над и под проёмом нужны короткие куски — калькулятор
            раскладывает их по остаткам рулонов и добавляет рулоны, если остатков не хватает. Если
            такой план не дешевле, чем клеить полные полосы, проёмы не учитываются.
          </li>
          <li>Число рулонов округляется вверх.</li>
        </ol>
      </section>

      <section aria-labelledby="formula-title">
        <h2 id="formula-title">Формулы</h2>
        <dl class="formula-list">
          <div>
            <dt>Периметр</dt>
            <dd>
              <code>P = 2 × (длина + ширина)</code>
            </dd>
          </div>
          <div>
            <dt>Число полос (по стенам)</dt>
            <dd>
              <code>N = 2 × ⌈длина ÷ ширина рулона⌉ + 2 × ⌈ширина ÷ ширина рулона⌉</code>
            </dd>
          </div>
          <div>
            <dt>Длина полосы</dt>
            <dd>
              <code>S = высота + подрезка</code>; с раппортом <code>r</code>:
              <code>S = ⌈(высота + подрезка) ÷ r⌉ × r</code>
            </dd>
          </div>
          <div>
            <dt>Полос из рулона</dt>
            <dd>
              <code>k = ⌊длина рулона ÷ S⌋</code>; с раппортом:
              <code>k = ⌊(длина рулона − r − высота − подрезка) ÷ S⌋ + 1</code>
            </dd>
          </div>
          <div>
            <dt>Экономия на проёме шириной a</dt>
            <dd>
              <code>e = max(0, ⌊a ÷ ширина рулона⌋ − 1)</code>; кусок над дверью —
              <code>высота − h + подрезка</code>, над и под окном —
              <code>высота − h + 2 × подрезка</code> (с раппортом: округление до кратного
              <code>r</code>, для окна ещё <code>+ r</code>)
            </dd>
          </div>
          <div>
            <dt>Рулонов</dt>
            <dd>
              <code>n = ⌈(N − Σe) ÷ k⌉</code> + рулоны на короткие куски, если они не поместились в
              остатки
            </dd>
          </div>
        </dl>
        <p>
          <code>⌈x⌉</code> — округление вверх, <code>⌊x⌋</code> — вниз. Расчёт ведётся с точностью
          до миллиметра.
        </p>
        <p>
          <strong>Пример.</strong> Комната 4 × 3 м, высота 2,5 м, рулон 0,53 × 10,05 м, подрезка 10
          см: N = 2 × ⌈4 ÷ 0,53⌉ + 2 × ⌈3 ÷ 0,53⌉ = 2 × 8 + 2 × 6 = 28 полос, S = 2,6 м, k = ⌊10,05
          ÷ 2,6⌋ = 3, рулонов ⌈28 ÷ 3⌉ = 10.
        </p>
      </section>

      <section aria-labelledby="limits-title">
        <h2 id="limits-title">Что калькулятор не учитывает</h2>
        <ul>
          <li>Ниши, выступы, короба и стены разной высоты — комната считается прямоугольной.</li>
          <li>
            Удачное расположение проёмов: если окно стоит точно по стыкам полос, расход может быть
            немного меньше.
          </li>
          <li>
            Перенос обрезка угловой полосы на соседнюю стену: опытный мастер так сэкономит до полосы
            на каждом углу.
          </li>
          <li>
            Высоту подоконника: при раппорте кусок под окном считается с запасом на совмещение
            рисунка.
          </li>
          <li>Повторное использование обрезков, кроме остатков в конце рулонов.</li>
          <li>Брак, ошибки при поклейке и обои со смещённой стыковкой рисунка.</li>
        </ul>
      </section>

      <section aria-labelledby="faq-title">
        <h2 id="faq-title">Частые вопросы</h2>
        <div class="faq">
          <h3>Почему окна почти не уменьшают количество рулонов?</h3>
          <p>
            Полосы по краям окна всё равно режутся из полной длины, а над и под окном нужны короткие
            куски. Экономия появляется, только когда проём шире двух полос. Например, при ширине
            рулона 0,53 м окно шириной 1,5 м экономит одну полосу, а дверь шириной 0,9 м — ни одной.
            При крупном раппорте куски над и под окном с подгонкой рисунка могут оказаться не короче
            полной полосы — тогда экономии нет совсем.
          </p>

          <h3>Что такое раппорт и где его найти?</h3>
          <p>
            Раппорт — расстояние, через которое рисунок повторяется по вертикали. Он указан на
            этикетке рулона в сантиметрах, например «64/32» или «64» рядом со значком стыковки.
            Первое число — раппорт. Для однотонных обоев и обоев «без подбора» раппорт не нужен.
          </p>

          <h3>Сколько закладывать на подрезку?</h3>
          <p>
            Обычно 5–10 см на полосу — по несколько сантиметров сверху и снизу, чтобы аккуратно
            подрезать обои у потолка и плинтуса. При неровном потолке или полу запас лучше
            увеличить.
          </p>

          <h3>Как считать метровые обои?</h3>
          <p>
            Укажите ширину рулона 1,06 м. Полос получится примерно вдвое меньше, но каждая тяжелее и
            в узких местах (между окном и углом) обрезков будет больше.
          </p>

          <h3>Нужно ли брать запасной рулон?</h3>
          <p>
            Калькулятор уже учитывает подрезку, раппорт и округление вверх. Запасной рулон из той же
            партии пригодится, если рисунок сложный, стены неровные или вы клеите обои впервые:
            докупить позже рулон того же оттенка бывает трудно.
          </p>

          <h3>Как учесть потолок?</h3>
          <p>Этот калькулятор считает только стены. Для потолка нужен отдельный расчёт.</p>
        </div>
      </section>
    </article>

    <RelatedCalculators current={entry} />
  </div>
</BaseLayout>

<script>
  import { initCalculatorForm } from '../../client/calculator-form';
  import { evaluateWallpaperForm, wallpaperFields } from '../../lib/calculators/wallpaper-form';
  import { formatNumber, formatRubles } from '../../lib/format';
  import { pluralizeRu, rollWordForms, stripWordForms } from '../../lib/plural';

  const form = document.querySelector<HTMLFormElement>('[data-wallpaper-form]');
  const result = document.querySelector<HTMLElement>('[data-calculator-result]');

  if (form && result) {
    initCalculatorForm({
      form,
      result,
      fields: wallpaperFields,
      evaluate: evaluateWallpaperForm,
      render(value, view) {
        const cost = value.totalCost === null ? '' : ` · ${formatRubles(value.totalCost)}`;
        view.summary(`${value.rolls} ${pluralizeRu(value.rolls, rollWordForms)}${cost}`);
        view.text('rolls', String(value.rolls));
        view.text('rollsWord', pluralizeRu(value.rolls, rollWordForms));
        view.text('perimeter', formatNumber(value.perimeter, 3));
        view.text('wallArea', formatNumber(value.wallArea));
        view.text('openingsArea', formatNumber(value.openingsArea));
        view.text('stripsForWalls', String(value.stripsForWalls));
        view.text('stripsSavedByOpenings', String(value.stripsSavedByOpenings));
        view.text('fullStrips', String(value.fullStrips));
        view.text('stripLength', formatNumber(value.stripLength, 3));
        view.text('rollStartAllowance', formatNumber(value.rollStartAllowance, 3));
        view.text('stripsPerRoll', String(value.stripsPerRoll));
        view.text('shortPieces', String(value.shortPieces));
        view.text('shortPiecesLength', formatNumber(value.shortPiecesLength, 3));
        view.text('extraRollsForShortPieces', String(value.extraRollsForShortPieces));
        view.show('openings', value.openingsArea > 0);
        view.show('rollStart', value.rollStartAllowance > 0);
        view.show('shortPieces', value.shortPieces > 0);
        view.show('totalCost', value.totalCost !== null);
        if (value.totalCost !== null) view.text('totalCost', formatRubles(value.totalCost));

        const parts = [
          `Полоса ${formatNumber(value.stripLength, 3)} м = высота стен + подрезка ${formatNumber(value.trimAllowance)} см`,
        ];
        if (value.patternRepeat > 0) {
          parts.push(`с округлением до кратного раппорту ${formatNumber(value.patternRepeat)} см`);
        }
        view.text(
          'stripNote',
          `${parts.join(', ')}. Из рулона выходит ${value.stripsPerRoll} ${pluralizeRu(
            value.stripsPerRoll,
            stripWordForms,
          )}.`,
        );
        const openingsGaveNothing = value.openingsArea > 0 && value.stripsSavedByOpenings === 0;
        view.show('openingsNote', openingsGaveNothing);
        if (openingsGaveNothing) {
          view.text(
            'openingsNote',
            'Проёмы не уменьшили расход: они уже двух полос или куски над и под ними с подгонкой рисунка не короче полной полосы.',
          );
        }
        view.report(
          [
            `Периметр ${formatNumber(value.perimeter, 3)} м, площадь стен ${formatNumber(value.wallArea)} м²`,
            `Полоса ${formatNumber(value.stripLength, 3)} м, из рулона ${value.stripsPerRoll} ${pluralizeRu(value.stripsPerRoll, stripWordForms)}`,
          ],
          `${value.rolls} ${pluralizeRu(value.rolls, rollWordForms)}${value.totalCost === null ? '' : ` на ${formatRubles(value.totalCost)}`}`,
        );
      },
    });
  }
</script>
