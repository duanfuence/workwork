---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
import CalculatorIntro from '../../components/calculator/CalculatorIntro.astro';
import CalculatorResult from '../../components/calculator/CalculatorResult.astro';
import RoomNext from '../../components/calculator/RoomNext.astro';
import NumberField from '../../components/calculator/NumberField.astro';
import Schematic from '../../components/calculator/Schematic.astro';
import PresetSelect from '../../components/calculator/PresetSelect.astro';
import PresetTable from '../../components/calculator/PresetTable.astro';
import SelectField from '../../components/calculator/SelectField.astro';
import { calculators } from '../../data/calculators';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculatorCrumbs } from '../../lib/breadcrumbs';
import '../../styles/calculator.css';

const entry = calculators.find((item) => item.id === 'putty');
if (!entry) throw new Error('В каталоге нет калькулятора шпаклёвки (id: putty)');

const id = 'pt';
---

<BaseLayout title={entry.seo.title} description={entry.seo.description}>
  <div class="container calc-page">
    <Breadcrumbs items={calculatorCrumbs(entry)} />

    <CalculatorIntro
      entry={entry}
      lead="Сколько шпаклёвки и упаковок нужно на стены и потолок — по слоям и расходу."
    />

    <noscript>
      <p class="calc-noscript">
        Для&nbsp;расчёта нужен включённый JavaScript. Способ расчёта описан ниже&nbsp;— по&nbsp;нему
        можно посчитать вручную.
      </p>
    </noscript>

    <div class="calc-layout">
      <form class="calc-form" data-putty-form novalidate aria-labelledby="calc-form-title">
        <h2 class="visually-hidden" id="calc-form-title">
          Параметры расчёта
        </h2>

        <Schematic kind="room-or-walls" initial={{ mode: 'room', wallCount: '1' }} />

        <fieldset class="calc-group">
          <legend class="calc-group__title">Стены и&nbsp;потолок</legend>
          <div class="calc-group__fields">
            <SelectField
              name="mode"
              idPrefix={id}
              label="Считать"
              value="room"
              options={[
                { value: 'room', label: 'помещение' },
                { value: 'walls', label: 'отдельные стены' },
              ]}
              hint="Помещение — все стены комнаты по длине и ширине; отдельные стены — по размеру одной стены."
            />
            <NumberField
              name="roomLength"
              idPrefix={id}
              label="Длина помещения"
              unit="м"
              showWhen="mode=room"
            />
            <NumberField
              name="roomWidth"
              idPrefix={id}
              label="Ширина помещения"
              unit="м"
              showWhen="mode=room"
            />
            <NumberField
              name="wallLength"
              idPrefix={id}
              label="Длина стены"
              unit="м"
              showWhen="mode=walls"
              hidden
            />
            <NumberField name="wallHeight" idPrefix={id} label="Высота стен" unit="м" />
            <NumberField
              name="wallCount"
              idPrefix={id}
              label="Одинаковых стен"
              unit="шт."
              inputmode="numeric"
              value="1"
              hint="Стены разного размера посчитайте по отдельности."
              showWhen="mode=walls"
              hidden
            />
            <NumberField
              name="openingsArea"
              idPrefix={id}
              label="Площадь окон и дверей"
              unit="м²"
              optional
              hint="Суммарно на все стены, вычитается. Пусто — 0."
            />
            <SelectField
              name="ceiling"
              idPrefix={id}
              label="Потолок"
              value="no"
              showWhen="mode=room"
              options={[
                { value: 'no', label: 'не шпаклевать' },
                { value: 'yes', label: 'шпаклевать' },
              ]}
              hint="Добавляется площадь потолка (длина × ширина) с теми же слоями и расходом."
            />
          </div>
        </fieldset>

        <fieldset class="calc-group">
          <legend class="calc-group__title">Шпаклёвка</legend>
          <div class="calc-group__fields">
            <NumberField
              name="layers"
              idPrefix={id}
              label="Количество слоёв"
              unit="шт."
              inputmode="numeric"
              value="1"
              hint="Целое число, 1–10. Сколько слоёв нужно, зависит от поверхности и смеси."
            />
            <PresetSelect
              calculator="putty"
              field="consumption"
              idPrefix={id}
              label="Тип шпаклёвки"
            />
            <NumberField
              name="consumption"
              idPrefix={id}
              label="Расход на один слой"
              unit="кг/м²"
              placeholder="с упаковки"
              hint="Точное значение — на упаковке. Без неё выберите тип материала: ориентир по данным производителей для слоя 1 мм (для 2 мм — вдвое больше)."
            />
            <NumberField
              name="packMass"
              idPrefix={id}
              label="Масса упаковки"
              unit="кг"
              optional
              hint="Мешка или ведра — чтобы посчитать упаковки. Пусто — только килограммы."
            />
          </div>
        </fieldset>

        <fieldset class="calc-group">
          <legend class="calc-group__title">
            Запас <span class="calc-group__optional">необязательно</span>
          </legend>
          <div class="calc-group__fields">
            <NumberField
              name="reserve"
              idPrefix={id}
              label="Запас"
              unit="%"
              value="10"
              optional
              hint="На неровности, впитывание основания и потери при работе. Пусто — 0 %."
            />
          </div>
        </fieldset>

        <div class="calc-actions">
          <button class="button button--primary" type="submit">
            Рассчитать
          </button>
          <button class="button button--secondary" type="reset">
            Сбросить
          </button>
        </div>
      </form>

      <CalculatorResult
        headingId="calc-result-title"
        title={entry.shortTitle}
        placeholder="Заполните размеры стен и расход шпаклёвки и нажмите «Рассчитать». После первого расчёта результат обновляется сразу при изменении параметров."
      >
        <!-- С массой упаковки главная цифра — упаковки, килограммы — строкой «нужно»; без неё — килограммы. -->
        <p class="calc-result__main">
          <span class="calc-result__number" data-out="buyNumber"></span>
          <span class="calc-result__unit" data-out="buyUnit"></span>
          <span class="calc-result__explain" data-row="packs" hidden>
            нужно <span data-out="massWithReserve"></span>&nbsp;кг
          </span>
        </p>
        <p class="calc-result__preset" data-preset-note="consumption" hidden></p>

        <h3 class="calc-result__subtitle">Как получилось</h3>
        <dl class="calc-result__list">
          <div>
            <dt>Площадь стен</dt>
            <dd>
              <span data-out="wallArea"></span>&nbsp;м²
            </dd>
          </div>
          <div data-row="ceilingArea">
            <dt>Плюс потолок</dt>
            <dd>
              <span data-out="ceilingArea"></span>&nbsp;м²
            </dd>
          </div>
          <div class="calc-result__minus">
            <dt>Окна и&nbsp;двери</dt>
            <dd>
              <span data-out="openingsArea"></span>&nbsp;м²
            </dd>
          </div>
          <div>
            <dt>Шпаклевать</dt>
            <dd>
              <span data-out="puttyArea"></span>&nbsp;м²
            </dd>
          </div>
          <div>
            <dt>Расход без запаса</dt>
            <dd>
              <span data-out="mass"></span>&nbsp;кг
            </dd>
          </div>
          <div>
            <dt>
              С&nbsp;запасом <span data-out="reserve"></span>&nbsp;%
            </dt>
            <dd>
              <span data-out="massWithReserve2"></span>&nbsp;кг
            </dd>
          </div>
          <div data-row="packs" hidden>
            <dt>Упаковки</dt>
            <dd>
              <span data-out="packs"></span>&nbsp;× <span data-out="packMass"></span>&nbsp;кг
              =&nbsp;<span data-out="massToBuy"></span>&nbsp;кг
            </dd>
          </div>
        </dl>

        <div class="calc-result__section">
          <h3 class="calc-result__subtitle">Формула</h3>
          <p class="calc-result__note" data-out="formula"></p>
        </div>
        <p class="calc-result__note">
          Результат ориентировочный. Реальный расход зависит от&nbsp;состава шпаклёвки, состояния
          и&nbsp;впитываемости поверхности, толщины нанесения и&nbsp;рекомендаций производителя.
        </p>
      </CalculatorResult>
    </div>

    <RoomNext current={entry} />

    <article class="calc-article">
      <p class="calc-article__intro">
        Посчитайте, сколько шпаклёвки и&nbsp;упаковок купить на&nbsp;стены. Расчёт ориентировочный:
        реальный расход зависит от&nbsp;состава шпаклёвки, состояния поверхности, толщины нанесения
        и&nbsp;рекомендаций производителя. Расход на&nbsp;один слой возьмите из&nbsp;инструкции
        к&nbsp;вашей смеси.
      </p>

      <section aria-labelledby="method-title">
        <h2 id="method-title">Как считается</h2>
        <ol>
          <li>
            Площадь стен: для&nbsp;помещения&nbsp;— периметр × высота, 2 × (длина + ширина) ×
            высота; для&nbsp;отдельных стен&nbsp;— длина × высота × число одинаковых стен.
          </li>
          <li>
            Из&nbsp;неё вычитается площадь окон и&nbsp;дверей; если выбран потолок, прибавляется его
            площадь (длина × ширина)&nbsp;— получается площадь шпаклевания.
          </li>
          <li>Расход: площадь × расход на&nbsp;один слой × число слоёв.</li>
          <li>
            К&nbsp;расходу добавляется запас; упаковки округляются вверх до&nbsp;целой упаковки.
            Массы показаны с&nbsp;округлением вверх до&nbsp;0,1&nbsp;кг.
          </li>
        </ol>
      </section>

      <section aria-labelledby="formula-title">
        <h2 id="formula-title">Формулы</h2>
        <dl class="formula-list">
          <div>
            <dt>Площадь</dt>
            <dd>
              помещение: <code>2 × (длина + ширина) × высота − окна и&nbsp;двери + потолок</code>;
              стены:
              <code>длина × высота × число стен − окна и&nbsp;двери</code>
            </dd>
          </div>
          <div>
            <dt>Расход</dt>
            <dd>
              <code>площадь × расход на&nbsp;слой (кг/м²) × число слоёв</code>
            </dd>
          </div>
          <div>
            <dt>С&nbsp;запасом и&nbsp;упаковки</dt>
            <dd>
              <code>расход × (1 + запас ÷ 100)</code>, упаковок
              <code>⌈расход с&nbsp;запасом ÷ масса упаковки⌉</code>
            </dd>
          </div>
        </dl>
        <p>
          <strong>Пример (отдельные стены).</strong> 4&nbsp;стены 4 × 2,7&nbsp;м, окна и&nbsp;двери
          3,9&nbsp;м²: шпаклевать 43,2 − 3,9 = 39,3&nbsp;м². 2&nbsp;слоя по&nbsp;1,1&nbsp;кг/м²:
          39,3 × 1,1 × 2 = 86,46&nbsp;кг. С&nbsp;запасом 10&nbsp;%&nbsp;— 95,106&nbsp;кг, упаковок
          по&nbsp;20&nbsp;кг&nbsp;— ⌈4,76⌉ = 5, это 100&nbsp;кг.
        </p>
      </section>

      <PresetTable calculator="putty" valueTitle="Расход" />

      <section aria-labelledby="limits-title">
        <h2 id="limits-title">Что калькулятор не&nbsp;учитывает</h2>
        <ul>
          <li>
            Разные смеси в&nbsp;одном расчёте: стартовую и&nbsp;финишную шпаклёвку посчитайте
            по&nbsp;отдельности, каждую со&nbsp;своим расходом.
          </li>
          <li>
            Толщину нанесения: расход на&nbsp;слой задаёте вы, по&nbsp;инструкции
            и&nbsp;с&nbsp;учётом неровностей.
          </li>
          <li>Откосы окон и&nbsp;дверей&nbsp;— их можно посчитать отдельной стеной.</li>
          <li>Грунтовку, армирующую сетку, углы и&nbsp;потери при шлифовке.</li>
          <li>Разные стены в&nbsp;одном расчёте&nbsp;— посчитайте их по&nbsp;отдельности.</li>
        </ul>
      </section>

      <section aria-labelledby="faq-title">
        <h2 id="faq-title">Частые вопросы</h2>
        <div class="faq">
          <h3>Где взять расход на&nbsp;один слой?</h3>
          <p>
            На&nbsp;упаковке или в&nbsp;инструкции производителя. Обычно он указан
            в&nbsp;килограммах на&nbsp;1&nbsp;м²&nbsp;— для&nbsp;определённой толщины слоя. Если
            в&nbsp;инструкции расход дан на&nbsp;1&nbsp;мм, умножьте его на&nbsp;толщину вашего слоя
            в&nbsp;миллиметрах. Расход стартовых и&nbsp;финишных шпаклёвок заметно различается,
            поэтому калькулятор не&nbsp;подставляет универсальное значение.
          </p>

          <h3>Сколько слоёв нужно?</h3>
          <p>
            Зависит от&nbsp;поверхности и&nbsp;смеси: ровной стене под покраску может хватить
            финишного слоя, неровной нужен стартовый. Число и&nbsp;толщину слоёв лучше сверить
            с&nbsp;инструкцией к&nbsp;смеси.
          </p>

          <h3>Почему фактический расход отличается?</h3>
          <p>
            На&nbsp;расход влияют впитываемость основания, качество грунтовки, перепады стены,
            способ нанесения и&nbsp;шлифовка. Поэтому результат&nbsp;— оценка, а&nbsp;запас помогает
            не&nbsp;докупать смесь в&nbsp;процессе.
          </p>
        </div>
      </section>
    </article>

    <RelatedCalculators current={entry} />
  </div>
</BaseLayout>

<script>
  import { initCalculatorForm } from '../../client/calculator-form';
  import { evaluatePuttyForm, puttyFields } from '../../lib/calculators/putty-form';
  import { formatNumber } from '../../lib/format';
  import { pluralizeRu } from '../../lib/plural';
  import { packagePurchase } from '../../lib/purchase';

  const form = document.querySelector<HTMLFormElement>('[data-putty-form]');
  const result = document.querySelector<HTMLElement>('[data-calculator-result]');
  const layerWords = ['слой', 'слоя', 'слоёв'] as const;
  const packWords = ['упаковка', 'упаковки', 'упаковок'] as const;

  if (form && result) {
    initCalculatorForm({
      form,
      result,
      fields: puttyFields,
      evaluate: evaluatePuttyForm,
      render(value, view) {
        // «К покупке» — упаковки, если известна их масса (D-031); иначе килограммы.
        const purchase =
          value.packs !== null && value.packMass !== null
            ? packagePurchase(
                value.packs,
                packWords,
                `${formatNumber(value.packMass, 1)} кг`,
                `${formatNumber(value.massWithReserve, 1)} кг`,
              )
            : null;
        view.text('buyNumber', purchase?.number ?? formatNumber(value.massWithReserve, 1));
        view.text('buyUnit', purchase?.unit ?? 'кг шпаклёвки');
        view.summary(purchase?.summary ?? `${formatNumber(value.massWithReserve, 1)} кг шпаклёвки`);
        view.text('massWithReserve', formatNumber(value.massWithReserve, 1));
        view.text('massWithReserve2', formatNumber(value.massWithReserve, 1));
        view.text('mass', formatNumber(value.mass, 1));
        view.text('reserve', formatNumber(value.reserve, 1));
        view.text('wallArea', formatNumber(value.wallArea, 2));
        view.text('openingsArea', formatNumber(value.openingsArea, 2));
        view.text('puttyArea', formatNumber(value.puttyArea, 2));
        view.show('ceilingArea', value.ceilingIncluded);
        view.text('ceilingArea', formatNumber(value.ceilingArea, 2));

        view.show('packs', value.packs !== null);
        if (value.packs !== null && value.packMass !== null && value.massToBuy !== null) {
          view.text('packs', String(value.packs));
          view.text('packMass', formatNumber(value.packMass, 1));
          view.text('massToBuy', formatNumber(value.massToBuy, 1));
        }

        const packs =
          value.packs === null
            ? ''
            : `; упаковок по ${formatNumber(value.packMass ?? 0, 1)} кг — ${value.packs} ${pluralizeRu(value.packs, packWords)} (вверх до целой)`;
        const ceiling = value.ceilingIncluded
          ? ` + потолок ${formatNumber(value.ceilingArea, 2)}`
          : '';
        // Для помещения — откуда площадь: стены − проёмы (+ потолок).
        const areaText =
          value.mode === 'room'
            ? `${formatNumber(value.wallArea, 2)} − ${formatNumber(value.openingsArea, 2)}${ceiling} = ${formatNumber(value.puttyArea, 2)} м²; `
            : '';
        view.text(
          'formula',
          `${areaText}${formatNumber(value.puttyArea, 2)} м² × ${formatNumber(value.consumption, 2)} кг/м² × ${value.layers} ${pluralizeRu(value.layers, layerWords)} ≈ ${formatNumber(value.mass, 1)} кг; с запасом ${formatNumber(value.reserve, 1)} % — ${formatNumber(value.massWithReserve, 1)} кг${packs}.`,
        );
        view.report(
          [
            `Площадь ${formatNumber(value.puttyArea, 2)} м²${value.ceilingIncluded ? ' (с потолком)' : ''}`,
            `${value.layers} ${pluralizeRu(value.layers, layerWords)} по ${formatNumber(value.consumption, 2)} кг/м², запас ${formatNumber(value.reserve, 1)} %`,
          ],
          purchase?.purchase ?? `${formatNumber(value.massWithReserve, 1)} кг шпаклёвки`,
        );
      },
    });
  }
</script>
