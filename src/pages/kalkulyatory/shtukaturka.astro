---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CalculatorResult from '../../components/calculator/CalculatorResult.astro';
import NumberField from '../../components/calculator/NumberField.astro';
import { calculators } from '../../data/calculators';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/calculator.css';

const entry = calculators.find((item) => item.id === 'plaster');
if (!entry) throw new Error('В каталоге нет калькулятора штукатурки (id: plaster)');

const id = 'pl';
---

<BaseLayout title={entry.seo.title} description={entry.seo.description}>
  <div class="container calc-page">
    <Breadcrumbs
      items={[
        { label: 'Главная', href: '/' },
        { label: 'Калькуляторы', href: '/#catalog' },
        { label: entry.title },
      ]}
    />

    <header class="calc-intro">
      <h1 class="calc-intro__title">{entry.title}</h1>
      <p class="calc-intro__lead">
        Посчитайте, сколько штукатурной смеси и мешков купить на стены. Расчёт ориентировочный:
        фактический расход зависит от смеси, основания, неровностей стен и допустимой толщины слоя.
        Расход на 1 мм возьмите из инструкции к вашей смеси.
      </p>
    </header>

    <noscript>
      <p class="calc-noscript">
        Для расчёта нужен включённый JavaScript. Способ расчёта описан ниже — по нему можно
        посчитать вручную.
      </p>
    </noscript>

    <div class="calc-layout">
      <form class="calc-form" data-plaster-form novalidate aria-labelledby="calc-form-title">
        <h2 class="visually-hidden" id="calc-form-title">
          Параметры расчёта
        </h2>

        <fieldset class="calc-group">
          <legend class="calc-group__title">Стены</legend>
          <div class="calc-group__fields">
            <NumberField name="wallLength" idPrefix={id} label="Длина стены" unit="м" />
            <NumberField name="wallHeight" idPrefix={id} label="Высота стены" unit="м" />
            <NumberField
              name="wallCount"
              idPrefix={id}
              label="Одинаковых стен"
              unit="шт."
              inputmode="numeric"
              value="1"
              hint="Стены разного размера посчитайте по отдельности."
            />
            <NumberField
              name="openingsArea"
              idPrefix={id}
              label="Площадь окон и дверей"
              unit="м²"
              optional
              hint="Суммарно на все стены, вычитается. Пусто — 0."
            />
          </div>
        </fieldset>

        <fieldset class="calc-group">
          <legend class="calc-group__title">Смесь</legend>
          <div class="calc-group__fields">
            <NumberField
              name="thickness"
              idPrefix={id}
              label="Средняя толщина слоя"
              unit="мм"
              value="10"
              hint="10 мм — пример. Задайте по замерам отклонений стены, в пределах инструкции к смеси."
            />
            <NumberField
              name="consumption"
              idPrefix={id}
              label="Расход на 1 м² при слое 1 мм"
              unit="кг"
              placeholder="из инструкции"
              hint="Указан на мешке или в инструкции к смеси; у гипсовых и цементных смесей он разный."
            />
            <NumberField
              name="bagMass"
              idPrefix={id}
              label="Масса мешка"
              unit="кг"
              optional
              hint="С мешка — чтобы посчитать мешки. Пусто — только масса."
            />
          </div>
        </fieldset>

        <fieldset class="calc-group">
          <legend class="calc-group__title">
            Запас <span class="calc-group__optional">необязательно</span>
          </legend>
          <div class="calc-group__fields">
            <NumberField
              name="reserve"
              idPrefix={id}
              label="Запас"
              unit="%"
              value="10"
              optional
              hint="На неровности, впитывание основания и потери при работе. Пусто — 0 %."
            />
          </div>
        </fieldset>

        <div class="calc-actions">
          <button class="button button--primary" type="submit">
            Рассчитать
          </button>
          <button class="button button--secondary" type="reset">
            Сбросить
          </button>
        </div>
      </form>

      <CalculatorResult
        headingId="calc-result-title"
        placeholder="Заполните размеры стен и расход смеси и нажмите «Рассчитать». После первого расчёта результат обновляется сразу при изменении параметров."
      >
        <p class="calc-result__main" role="status">
          <span class="calc-result__number" data-out="massWithReserve"></span>
          <span class="calc-result__unit">кг смеси</span>
        </p>
        <p class="calc-result__cost" data-row="bags" hidden>
          Мешков по <span data-out="bagMass"></span> кг: <strong data-out="bags"></strong>
          {' — это '}
          <span data-out="massToBuy"></span> кг.
        </p>

        <dl class="calc-result__list">
          <div>
            <dt>Площадь стен</dt>
            <dd>
              <span data-out="wallArea"></span> м²
            </dd>
          </div>
          <div>
            <dt>Окна и двери</dt>
            <dd>
              <span data-out="openingsArea"></span> м²
            </dd>
          </div>
          <div>
            <dt>Штукатурить</dt>
            <dd>
              <span data-out="plasterArea"></span> м²
            </dd>
          </div>
          <div>
            <dt>Смесь без запаса</dt>
            <dd>
              <span data-out="mass"></span> кг
            </dd>
          </div>
          <div>
            <dt>
              С запасом <span data-out="reserve"></span> %
            </dt>
            <dd>
              <span data-out="massWithReserve2"></span> кг
            </dd>
          </div>
        </dl>

        <div class="calc-result__section">
          <h3 class="calc-result__subtitle">Как получилось</h3>
          <p class="calc-result__note" data-out="formula"></p>
        </div>
        <p class="calc-result__note">
          Результат ориентировочный. Фактический расход зависит от состава смеси, впитываемости
          основания, неровностей стен и маяков. Допустимую толщину слоя за один проход и общую
          проверьте по инструкции — калькулятор её не проверяет.
        </p>
      </CalculatorResult>
    </div>

    <article class="calc-article">
      <section aria-labelledby="method-title">
        <h2 id="method-title">Как считается</h2>
        <ol>
          <li>Площадь стен: длина × высота × число одинаковых стен.</li>
          <li>Из неё вычитается площадь окон и дверей — получается площадь оштукатуривания.</li>
          <li>Масса смеси: площадь × средняя толщина слоя × расход на 1 м² при слое 1 мм.</li>
          <li>
            К массе добавляется запас; мешки округляются вверх до целого мешка. Массы показаны с
            округлением вверх до 0,1 кг.
          </li>
        </ol>
      </section>

      <section aria-labelledby="formula-title">
        <h2 id="formula-title">Формулы</h2>
        <dl class="formula-list">
          <div>
            <dt>Площадь</dt>
            <dd>
              <code>длина × высота × число стен − окна и двери</code>
            </dd>
          </div>
          <div>
            <dt>Масса</dt>
            <dd>
              <code>площадь × толщина (мм) × расход (кг/м² на 1 мм)</code>
            </dd>
          </div>
          <div>
            <dt>С запасом и мешки</dt>
            <dd>
              <code>масса × (1 + запас ÷ 100)</code>, мешков
              <code>⌈масса с запасом ÷ масса мешка⌉</code>
            </dd>
          </div>
        </dl>
        <p>
          <strong>Пример.</strong> 4 стены 4 × 2,7 м, окна и двери 3,9 м²: штукатурить 43,2 − 3,9 =
          39,3 м². Слой 15 мм, расход 0,85 кг: 39,3 × 15 × 0,85 = 501,075 кг. С запасом 10 % —
          551,1825 кг, мешков по 25 кг — ⌈22,05⌉ = 23, это 575 кг.
        </p>
      </section>

      <section aria-labelledby="limits-title">
        <h2 id="limits-title">Что калькулятор не учитывает</h2>
        <ul>
          <li>
            Рельеф стены: толщина задаётся средняя. Её определяют по замерам отклонений, например
            правилом или по маякам.
          </li>
          <li>Откосы окон и дверей — их можно посчитать отдельной стеной.</li>
          <li>Грунтовку, сетку, маяки и углы.</li>
          <li>
            Допустимую толщину слоя: сколько можно нанести за один проход и всего, зависит от смеси.
          </li>
          <li>Разные стены в одном расчёте — посчитайте их по отдельности.</li>
        </ul>
      </section>

      <section aria-labelledby="faq-title">
        <h2 id="faq-title">Частые вопросы</h2>
        <div class="faq">
          <h3>Где взять расход на 1 мм?</h3>
          <p>
            На мешке или в инструкции производителя: обычно он указан как «кг на 1 м² при толщине
            слоя 1 мм». Расход гипсовых и цементных смесей заметно различается, поэтому калькулятор
            не подставляет универсальное значение.
          </p>

          <h3>Как определить среднюю толщину слоя?</h3>
          <p>
            Измерьте отклонения стены от вертикали и плоскости в нескольких местах, например
            правилом или после установки маяков, и возьмите среднее с учётом минимального слоя по
            инструкции. Если стена неровная, лучше посчитать с запасом.
          </p>

          <h3>Почему фактический расход отличается?</h3>
          <p>
            На расход влияют впитываемость основания, качество грунтовки, перепады стены, способ
            нанесения и потери при работе. Поэтому результат — оценка, а запас помогает не докупать
            смесь в процессе.
          </p>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>

<script>
  import { initCalculatorForm } from '../../client/calculator-form';
  import { evaluatePlasterForm, plasterFields } from '../../lib/calculators/plaster-form';
  import { formatNumber } from '../../lib/format';
  import { pluralizeRu } from '../../lib/plural';

  const form = document.querySelector<HTMLFormElement>('[data-plaster-form]');
  const result = document.querySelector<HTMLElement>('[data-calculator-result]');
  const bagWords = ['мешок', 'мешка', 'мешков'] as const;

  if (form && result) {
    initCalculatorForm({
      form,
      result,
      fields: plasterFields,
      evaluate: evaluatePlasterForm,
      render(value, view) {
        view.text('massWithReserve', formatNumber(value.massWithReserve, 1));
        view.text('massWithReserve2', formatNumber(value.massWithReserve, 1));
        view.text('mass', formatNumber(value.mass, 1));
        view.text('reserve', formatNumber(value.reserve, 1));
        view.text('wallArea', formatNumber(value.wallArea, 2));
        view.text('openingsArea', formatNumber(value.openingsArea, 2));
        view.text('plasterArea', formatNumber(value.plasterArea, 2));

        view.show('bags', value.bags !== null);
        if (value.bags !== null && value.bagMass !== null && value.massToBuy !== null) {
          view.text('bags', String(value.bags));
          view.text('bagMass', formatNumber(value.bagMass, 1));
          view.text('massToBuy', formatNumber(value.massToBuy, 1));
        }

        const bags =
          value.bags === null
            ? ''
            : `; мешков по ${formatNumber(value.bagMass ?? 0, 1)} кг — ${value.bags} ${pluralizeRu(value.bags, bagWords)} (вверх до целого)`;
        view.text(
          'formula',
          `${formatNumber(value.plasterArea, 2)} м² × ${formatNumber(value.thickness, 1)} мм × ${formatNumber(value.consumption, 2)} кг ≈ ${formatNumber(value.mass, 1)} кг; с запасом ${formatNumber(value.reserve, 1)} % — ${formatNumber(value.massWithReserve, 1)} кг${bags}.`,
        );
      },
    });
  }
</script>
