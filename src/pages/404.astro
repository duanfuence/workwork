---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена" description="Такой страницы нет на сайте." noindex>
  <section class="section">
    <div class="container">
      <div class="not-found">
        <p class="stamp not-found__code">Лист 404 · не найден</p>
        <h1>Страница не&nbsp;найдена</h1>
        <p>Возможно, калькулятор ещё в разработке или адрес набран с ошибкой.</p>
        <p class="not-found__links">
          <a class="button button--primary" href="/">
            На главную
          </a>
          <a class="button button--secondary" href="/kalkulyatory/">
            Все калькуляторы
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Лист чертежа на сетке: белая карточка с рамкой и штампом. */
  .not-found {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    max-width: 36rem;
    padding: var(--space-6);
    background: var(--color-surface);
    border: var(--border-ink);
    border-radius: var(--radius-lg);
  }

  .not-found__code {
    padding: var(--space-1) var(--space-2);
    border: var(--border-ink);
    color: var(--color-dimension-text);
  }

  .not-found h1 {
    font-size: var(--font-size-2xl);
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
</style>
