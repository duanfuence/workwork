---
/**
 * Видимая навигационная цепочка и (при заданном `site`) её JSON-LD BreadcrumbList — из одних `items`.
 */
import { breadcrumbList, serializeJsonLd, type Crumb } from '../lib/breadcrumbs';

interface Props {
  items: readonly Crumb[];
}

const { items } = Astro.props;
const jsonLd = Astro.site
  ? serializeJsonLd(breadcrumbList(items, Astro.site.origin, Astro.url.pathname))
  : undefined;
---

<nav class="breadcrumbs" aria-label="Навигационная цепочка">
  <ol class="breadcrumbs__list">
    {items.map((item) => (
      <li class="breadcrumbs__item">
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

<style>
  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumbs__item + .breadcrumbs__item::before {
    content: '/';
    color: var(--color-border-strong);
  }

  .breadcrumbs a {
    color: var(--color-text-secondary);
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
  }
</style>
