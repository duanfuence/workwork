---
import { navLinks } from '../config/navigation';
import { site } from '../config/site';
import { calculators } from '../data/calculators';
import { getAvailableCalculators } from '../lib/catalog';

const available = getAvailableCalculators(calculators);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__about">
      <p class="site-footer__name">{site.name}</p>
      <p class="site-footer__text">{site.tagline}.</p>
      <p class="site-footer__text">
        Результаты расчётов ориентировочные: точный расход зависит от материала и условий работы.
        Сверяйтесь с рекомендациями производителя.
      </p>
    </div>
    <nav class="site-footer__nav" aria-labelledby="footer-calculators-title">
      <p class="site-footer__heading" id="footer-calculators-title">
        Калькуляторы
      </p>
      <ul class="site-footer__links site-footer__links--calculators">
        {available.map((entry) => (
          <li>
            <a href={entry.path}>{entry.shortTitle}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="site-footer__nav" aria-labelledby="footer-nav-title">
      <p class="site-footer__heading" id="footer-nav-title">
        Разделы
      </p>
      <ul class="site-footer__links">
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="site-footer__bottom">
    <p class="container">
      © {year} {site.name}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-12);
    background: var(--color-surface);
    border-top: var(--border-ink);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }

  .site-footer__nav {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .site-footer__heading {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-stamp);
    font-weight: var(--font-weight-mono-bold);
    letter-spacing: var(--letter-spacing-stamp);
    text-transform: uppercase;
  }

  .site-footer__about {
    display: grid;
    gap: var(--space-2);
    max-width: 36rem;
  }

  .site-footer__name {
    color: var(--color-text);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
  }

  .site-footer__links {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Калькуляторы — в две колонки: короткие названия, список не растягивается на телефоне. */
  .site-footer__links--calculators {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-4);
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target-min);
    color: var(--color-text-secondary);
  }

  .site-footer__links a:hover {
    color: var(--color-accent);
  }

  .site-footer__bottom {
    padding-block: var(--space-4);
    border-top: var(--border);
  }
</style>
