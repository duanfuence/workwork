---
import { site } from '../config/site';
import { isCurrentSection, navLinks } from '../config/navigation';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href="/" aria-label={`${site.name} — на главную`}>
      <!-- Квадрат-рамка листа, план дома и оранжевый проём двери с дугой открывания. -->
      <svg class="logo__mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
        <rect class="logo__frame" x="1" y="1" width="30" height="30" rx="2"></rect>
        <path class="logo__walls" d="M12 23H8V9h16v14h-6"></path>
        <path class="logo__door" d="M12 23v-6a6 6 0 0 1 6 6"></path>
      </svg>
      <span class="logo__text">{site.name}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="nav-toggle__icon" aria-hidden="true"></span>
      <span class="nav-toggle__label">Меню</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Основная навигация" data-nav>
      <ul class="site-nav__list">
        {navLinks.map((link) => (
          <li>
            <a
              class="site-nav__link"
              href={link.href}
              aria-current={isCurrentSection(link.href, pathname) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-surface);
    border-bottom: var(--border-ink);
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target-min);
    color: var(--color-text);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  .logo:hover {
    color: var(--color-text);
  }

  .logo__mark {
    flex: none;
  }

  .logo__frame {
    fill: var(--color-surface);
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  .logo__walls {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 2;
    stroke-linejoin: miter;
  }

  .logo__door {
    fill: none;
    stroke: var(--color-dimension);
    stroke-width: 2;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target-min);
    padding: 0 var(--space-3);
    background: var(--color-surface);
    border: var(--border-ink);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--font-size-stamp);
    font-weight: var(--font-weight-mono);
    letter-spacing: var(--letter-spacing-stamp);
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .nav-toggle:hover {
    background: var(--color-accent-soft);
  }

  .nav-toggle__icon,
  .nav-toggle__icon::before,
  .nav-toggle__icon::after {
    display: block;
    width: 1rem;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform var(--transition-base);
  }

  .nav-toggle__icon {
    position: relative;
  }

  .nav-toggle__icon::before,
  .nav-toggle__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle__icon::before {
    top: -5px;
  }

  .nav-toggle__icon::after {
    top: 5px;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon {
    background: transparent;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon::before {
    transform: translateY(5px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* Высокая контрастность сбрасывает фоны — линии значка рисуются фоном и пропали бы; цвет — системный текста кнопки. */
  @media (forced-colors: active) {
    .nav-toggle__icon,
    .nav-toggle__icon::before,
    .nav-toggle__icon::after {
      forced-color-adjust: none;
    }
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target-min);
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--font-size-stamp);
    font-weight: var(--font-weight-mono);
    letter-spacing: var(--letter-spacing-stamp);
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .site-nav__link:hover {
    background: var(--color-accent-soft);
    color: var(--color-text);
  }

  /* Текущий раздел: цвет акцента и подчёркивание — не только цветом. */
  .site-nav__link[aria-current='page'] {
    color: var(--color-accent);
    font-weight: var(--font-weight-mono-bold);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  /* Мобильная навигация: раскрывающееся меню. Без JavaScript ссылки остаются видимыми. */
  @media (max-width: 47.99rem) {
    :global(.js) .nav-toggle {
      display: inline-flex;
    }

    :global(.js) .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: var(--space-2) var(--container-gutter) var(--space-4);
      background: var(--color-surface);
      border-bottom: var(--border);
      box-shadow: var(--shadow-md);
    }

    :global(.js) .site-nav.is-open {
      display: block;
    }

    :global(.js) .site-nav__list {
      flex-direction: column;
    }

    :global(.js) .site-nav__link {
      display: flex;
    }

    .site-nav__link {
      padding-inline: var(--space-2);
    }
  }
</style>
