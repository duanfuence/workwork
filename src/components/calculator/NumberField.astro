---
import { spokenUnit } from '../../lib/units';
import { typograph } from '../../lib/format';

interface Props {
  /** Имя поля формы. */
  name: string;
  /** Префикс id, уникальный для формы. */
  idPrefix: string;
  label: string;
  /**
   * Единица измерения справа от поля: «м», «см», «шт.», «₽». Видимое сокращение скрыто от скринридера,
   * в доступное имя поля входит словесная форма из src/lib/units.ts («Длина (в метрах)»).
   */
  unit?: string;
  hint?: string;
  /** Начальное значение (только там, где оно не вводит в заблуждение). */
  value?: string;
  placeholder?: string;
  /** `numeric` — целые числа, `decimal` — дробные. */
  inputmode?: 'decimal' | 'numeric';
  /** Необязательное поле (без aria-required). Пометка «необязательно» ставится у группы. */
  optional?: boolean;
  /**
   * Поле одного режима формы: `"mode=room"` — видно, пока в выборе `mode` значение `room`
   * (src/client/calculator-form.ts). Скрытое поле не разбирается и не проверяется.
   */
  showWhen?: string;
  /** Скрыто при загрузке: режим по умолчанию — другой. */
  hidden?: boolean;
  /**
   * Подсказка, когда значения этого поля мало: «Укажите объём банки — тогда посчитаем стоимость» (D-033). Видна,
   * пока в поле число, а поле `field` пусто (и, если задано, `when="tilePriceUnit=pack"` выполняется). Не ошибка
   * и не live-регион — входит в описание поля. Показывает общий механизм форм.
   */
  needs?: { field: string; when?: string; text: string } | undefined;
}

const {
  name,
  idPrefix,
  label,
  unit,
  hint,
  value = '',
  placeholder,
  inputmode = 'decimal',
  optional = false,
  showWhen,
  hidden = false,
  needs,
} = Astro.props;

const id = `${idPrefix}-${name}`;
const hintId = `${id}-hint`;
const errorId = `${id}-error`;
const warningId = `${id}-warning`;
const needsId = `${id}-needs`;
// Предупреждение о нетипичном значении (у полей с ориентирами) — в описании поля: диктор читает его при фокусе,
// а не на каждое нажатие (это не live-регион).
const describedBy = [hint ? hintId : null, errorId, warningId, needs ? needsId : null]
  .filter(Boolean)
  .join(' ');
---

<div class="field" data-show-when={showWhen} hidden={hidden}>
  <label class="field__label" for={id}>
    {typograph(label)}
    {unit && <span class="visually-hidden">{` (${spokenUnit(unit)})`}</span>}
  </label>
  <div class="field__body">
    <div class="field__control">
      <input
        class="field__input"
        id={id}
        name={name}
        type="text"
        inputmode={inputmode}
        autocomplete="off"
        spellcheck="false"
        value={value}
        placeholder={placeholder}
        aria-describedby={describedBy}
        aria-required={optional ? undefined : 'true'}
        data-label={label}
      />
      {unit && (
        <span class="field__unit" aria-hidden="true">
          {unit}
        </span>
      )}
    </div>
    {hint && (
      <p class="field__hint" id={hintId}>
        {typograph(hint)}
      </p>
    )}
    <p class="field__error" id={errorId} data-error-for={name} hidden></p>
    <p class="field__warning" id={warningId} data-warning-for={name} hidden></p>
    {needs && (
      <p
        class="field__needs"
        id={needsId}
        data-needs-for={name}
        data-needs={needs.field}
        data-needs-when={needs.when}
        hidden
      >
        {typograph(needs.text)}
      </p>
    )}
  </div>
</div>

<style>
  .field {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    min-width: 0;
  }

  .field[hidden] {
    display: none;
  }

  /* Поле, подсказка и ошибка — одна строка сетки: в ряду формы выравниваются по подписи (calculator.css). */
  .field__body {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    min-width: 0;
  }

  .field__label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .field__control {
    position: relative;
  }

  /* Поле «бланка»: тонкая рамка, снизу линия чернилами; значение моноширинное, 18 px. */
  .field__input {
    width: 100%;
    min-height: var(--control-height);
    padding: var(--space-2) 3rem var(--space-2) var(--space-3);
    background: var(--color-surface);
    border: var(--border-control);
    border-bottom: 2px solid var(--color-control-underline);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-mono);
    font-variant-numeric: tabular-nums;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .field__input::placeholder {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-regular);
  }

  .field__input:hover {
    border-color: var(--color-text-muted);
  }

  /* Прозрачный outline виден в режиме высокой контрастности, где тени отключены (global.css). */
  .field__input:focus-visible {
    outline: 2px solid transparent;
    outline-offset: 2px;
    border-color: var(--color-accent);
    box-shadow:
      inset 0 0 0 1px var(--color-accent),
      var(--control-focus-ring);
  }

  .field__input[aria-invalid='true'] {
    border-color: var(--color-danger);
    background: var(--color-danger-soft);
  }

  .field__input[aria-invalid='true']:focus-visible {
    box-shadow:
      inset 0 0 0 1px var(--color-danger),
      0 0 0 3px var(--color-danger-soft);
  }

  .field__unit {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    pointer-events: none;
  }

  .field__hint {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-snug);
  }

  .field__error {
    color: var(--color-danger);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-snug);
  }

  .field__error[hidden] {
    display: none;
  }

  /* Мягкое предупреждение «Обычно 7–14 м²/л — проверьте этикетку»: не ошибка, расчёт выполняется. */
  .field__warning {
    padding-left: var(--space-2);
    border-left: 2px solid var(--color-dimension);
    color: var(--color-dimension-text);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-snug);
  }

  .field__warning[hidden] {
    display: none;
  }

  /* Подсказка «Укажите … — тогда посчитаем стоимость»: справка, не ошибка и не предупреждение — нейтральная. */
  .field__needs {
    padding-left: var(--space-2);
    border-left: 2px solid var(--color-border-control);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-snug);
  }

  .field__needs[hidden] {
    display: none;
  }
</style>
