---
/**
 * Выбор «Тип материала» у поля расхода: подставляет ориентир из src/data/material-presets.ts
 * в поле `field`. Поле остаётся главным: ручная правка переключает выбор на «Своё значение».
 */
import { presetsFor, type PresetCalculator } from '../../data/material-presets';
import { customChoice, presetFieldText } from '../../lib/presets';
import SelectField from './SelectField.astro';

interface Props {
  calculator: PresetCalculator;
  /** Имя поля расхода, в которое подставляется значение. */
  field: string;
  idPrefix: string;
  label: string;
}

const { calculator, field, idPrefix, label } = Astro.props;
const options = [
  { value: customChoice, label: 'Своё значение (с упаковки)' },
  ...presetsFor(calculator).map((preset) => {
    const text = presetFieldText(preset.value);
    return {
      value: preset.id,
      // Без единицы: она видна в поле рядом, а длинная подпись обрезается в узкой колонке.
      label: `${preset.label} — ${text}`,
      fieldValue: text,
      note: `Расход: ориентир для ${preset.forNote} — сверьте с упаковкой.`,
    };
  }),
];
---

<SelectField
  name={`${field}Preset`}
  idPrefix={idPrefix}
  label={label}
  value={customChoice}
  options={options}
  presetFor={`${idPrefix}-${field}`}
  hint="Ориентир по данным производителей — подставится в поле расхода; точное значение — на упаковке."
/>
