---
import type { Category } from '../data/catalog.types';
import { calculatorWordForms, pluralizeRu } from '../lib/plural';

interface Props {
  category: Category;
  /** Сколько калькуляторов категории запланировано или в работе. */
  plannedCount: number;
  /** Сколько калькуляторов категории опубликовано. */
  availableCount: number;
}

const { category, plannedCount, availableCount } = Astro.props;

let summary: string;
if (availableCount > 0) {
  summary = `Доступно: ${availableCount} ${pluralizeRu(availableCount, calculatorWordForms)}`;
} else if (plannedCount > 0) {
  summary = `${plannedCount} ${pluralizeRu(plannedCount, calculatorWordForms)} в первой очереди`;
} else {
  summary = 'Калькуляторы появятся позже';
}
---

<li class="category-card">
  <h3 class="category-card__title">{category.title}</h3>
  <p class="category-card__text">{category.description}</p>
  <p class:list={['category-card__summary', { 'is-empty': plannedCount + availableCount === 0 }]}>
    {summary}
  </p>
</li>

<style>
  .category-card {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
  }

  .category-card__title {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-snug);
  }

  .category-card__text {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .category-card__summary {
    margin-top: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .category-card__summary.is-empty {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
  }
</style>
